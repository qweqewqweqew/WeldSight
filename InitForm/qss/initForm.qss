/* black_theme_enhanced.qss */

/* 主窗口样式 */
QWidget {
    background-color: #121212;
    color: #e0e0e0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    border: none;
}

/* 分组框样式 */
QGroupBox {
    background-color: #1e1e1e;
    border: 1px solid #424242;
    border-radius: 4px;
    margin-top: 1.5ex;
    padding: 10px;
}
#textTitle{
background-color: #2a2a2a;
color: #bb86fc;
padding: 6px 8px;
border: none;
font-size: 11pt;
font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
    background-color: #2a2a2a;
    color: #bb86fc;
    font-weight: bold;
    border-radius: 3px;
}

/* 表格样式 - 增强 */
QTableWidget {
    background-color: #1e1e1e;
    gridline-color: #424242;
    alternate-background-color: #252525;
    border: 1px solid #424242;
    border-radius: 3px;
    selection-background-color: #2e2a4a; /* 深紫色选中背景 */
    selection-color: #ffffff; /* 白色选中文字 */
}

/* 表格行悬停效果 */
QTableWidget::item:hover {
    background-color: #2d2d2d;
}

/* 表格行选中效果 */
QTableWidget::item:selected {
    background-color: #3a2d5f; /* 更深的紫色选中背景 */
    color: #ffffff;
    border: none;
}

/* 表头样式 */
QHeaderView::section {
    background-color: #2a2a2a;
    color: #bb86fc;
    padding: 6px 8px;
    border: none;
    font-weight: bold;
}

QHeaderView::section:hover {
    background-color: #353535;
}

/* 按钮样式 */
QPushButton {
    background-color: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #424242;
    border-radius: 4px;
    padding: 8px 15px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #3a3a3a;
    border-color: #555;
}

QPushButton:pressed {
    background-color: #1a1a1a;
}

/* 标签样式 */
QLabel {
    color: #e0e0e0;
}

QLabel#text_title {
    font-size: 12pt;
    font-weight: bold;
    color: #bb86fc;
    background-color: #2a2a2a;
    border-radius: 4px;
    padding: 5px 10px;
}

/* 图像视图样式 */
ImageZoomView {
    background-color: #000;
    border: 1px solid #424242;
    border-radius: 4px;
}

/* 表单布局中的标签 */
QFormLayout QLabel {
    padding: 3px 8px;
}

/* 状态指示器 */
.status-ok {
    color: #4caf50;
    font-weight: bold;
}

.status-warning {
    color: #ff9800;
    font-weight: bold;
}

.status-error {
    color: #f44336;
    font-weight: bold;
}

/* 滚动条样式 - 增强 */
QScrollBar:vertical {
    border: none;
    background: #1e1e1e;
    width: 12px;
    margin: 0;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: #555;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background: #777;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* 下拉阴影效果 */
QGraphicsDropShadowEffect {
    color: rgba(0, 0, 0, 200);
    blur-radius: 12px;
    offset: 0, 0;
}


/*QLineEdit */
QLineEdit {
    background: #2a2a2a;
    color: #e0e0e0;
    border: 1px solid #424242;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #bb86fc;
}
QLineEdit:focus {
    border-color: #bb86fc;
}
QLabel {
    color: #e0e0e0;
    background: transparent;
}
/* ===== Menu Bar ======================================================= */
QMenuBar {
    background: #121212;
    color: #e0e0e0;
    font: 10pt "Segoe UI";
    border-bottom: 1px solid #2c2c2c;
    spacing: 8px;                 /* 主菜单间距 */
}

QMenuBar::item {
    background: transparent;
    padding: 6px 12px;
    border-radius: 4px;
}

QMenuBar::item:selected,
QMenuBar::item:hover {
    background: #bb86fc;
    color: #121212;
}

QMenuBar::item:pressed {
    background: #9c6dff;
}

/* ===== Drop-down Menu ================================================== */
QMenu {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #323232;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 20px;
    border-radius: 2px;
}

QMenu::item:selected {
    background: #bb86fc;
    color: #121212;
}

QMenu::item:disabled {
    color: #555555;
    background: transparent;
}

QMenu::separator {
    height: 1px;
    background: #323232;
    margin: 4px 0px;
}

/* === QLineEdit 强化 === */
QLineEdit {
    background: #2e2e2e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 4px 6px;
    selection-background-color: #bb86fc;
    selection-color: #121212;
}
QLineEdit:focus {
    border-color: #bb86fc;
}

/* === QComboBox 完整深色 === */
QComboBox {
    background: #2e2e2e;
    color: #e0e0e0;
    border: 1px solid #555;
    border-radius: 4px;
}

/* 标题栏 */
#titleWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #1e1e1e, stop:1 #252525);
    border-bottom: 1px solid #323232;
}

/* 菜单栏 */
QMenuBar {
    background-color: #252525;
    border-bottom: 1px solid #323232;
}

/* 状态栏 */
#statusWidget {
    background-color: #1a1a1a;
    border-top: 1px solid #323232;
}

#titleWidget, #statusWidget {
    padding: 6px;
}
QMainWindow::separator {
    width: 0px;   /* 去掉默认分隔线，避免重复 */
}


#titleWidget QLabel {
    font-weight: bold;
    color: #bb86fc;   /* 紫色强调 */
}
QMenuBar {
    font-weight: 500;
}
#statusWidget QLabel {
    font-weight: 300;
    color: #9e9e9e;   /* 灰一点，弱化存在感 */
}




QPushButton {
    background: #353535;
    border: 1px solid #555;
    color: #e0e0e0;
}
QPushButton:hover:!pressed {
    background: #404040;
    border-color: #bb86fc;
}
QPushButton:pressed {
    background: #bb86fc;
    color: #121212;
}

QPushButton:disabled {
    background: rgba(42,42,42,0.8);
    border: 1px solid #444;
    color: #666;
}
